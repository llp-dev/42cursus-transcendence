# ─────────────────────────────────────────────────────────────
# Local development environment for the Transcendence stack.
# Consumed by: docker compose (infra/docker-compose.yml) and
# host-side tooling via mise (mise.toml -> _.file = infra/.env).
# Fixed topology values (DB_HOST/DB_PORT, REDIS_*) live directly
# in docker-compose.yml, not here. Do not commit real secrets.
# ─────────────────────────────────────────────────────────────

# ---- Server / ports (configurable) ----
API_PORT=8000
FRONTEND_PORT=3000
GIN_MODE=debug
FRONTEND_URL=http://localhost:3000

# ---- Rate limiting ----
# Max requests per client IP per minute (defaults to 20 if unset).
RATE_LIMIT_MAX=20

# ---- Database credentials (Postgres) ----
DB_USER=app
DB_PASSWORD=app
DB_NAME=app_db

# ---- Auth ----
JWT_SECRET=dev-only-change-me-0123456789abcdef

# ---- GitHub OAuth (fill in to enable GitHub login) ----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8000/api/auth/github/callback
